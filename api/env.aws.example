# AWS Development Environment Configuration  
# Copy this to .env when using AWS stack

# AWS Storage Configuration
STORAGE_TYPE=aws
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKETNAME=codepush-local-bucket
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Database Configuration (shared)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codepushdb
DB_USER=root
DB_PASS=root

# Redis Configuration (shared)
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Configuration
NODE_ENV=development
PORT=3000

# Debug Configuration
DEBUG_DISABLE_AUTH=false
DEBUG_USER_ID=

# Terms and Login Configuration
CURRENT_TERMS_VERSION=v1.0
LOGIN_AUTHORIZED_DOMAINS=dream11.com,example.com

# CloudFront Configuration (for production)
CLOUDFRONT_DOMAIN=
CLOUDFRONT_PRIVATE_KEY_PATH=
CLOUDFRONT_KEY_PAIR_ID=
